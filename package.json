{
  "name": "@saketek/saki-cli",
  "version": "0.3.0",
  "type": "module",
  "description": "Headless command line for the saki build orchestrator — drive a PRD → plan → build → QA → review journey from a terminal, on claude, codex or opencode.",
  "license": "MIT",
  "author": "drayanaindra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drayanaindra/saki-cli.git"
  },
  "homepage": "https://github.com/drayanaindra/saki-cli#readme",
  "bugs": {
    "url": "https://github.com/drayanaindra/saki-cli/issues"
  },
  "keywords": [
    "cli",
    "agent",
    "claude",
    "codex",
    "opencode",
    "orchestrator",
    "headless"
  ],
  "bin": {
    "saki": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/saki-backend",
    "docs",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "postinstall": "node scripts/fetch-backend-binary.mjs",
    "dev": "tsx src/index.ts",
    "stub:studio": "node scripts/stub-studio.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "backend:build": "cd backend && go build -trimpath -ldflags \"-s -w\" -o ../dist/saki-backend ./cmd/server",
    "backend:test": "cd backend && go test ./...",
    "pree2e": "bash scripts/free-e2e-ports.sh",
    "e2e": "playwright test",
    "test:e2e": "npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  }
}
